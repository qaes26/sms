# ==============================================================================
# SMS & WebRTC Application - Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Realtime & Persistence (Required for Vercel Serverless Production)
# ------------------------------------------------------------------------------
# Free Upstash Redis REST credentials (or Vercel KV via 1-click integration).
# In local development, if left blank, the app automatically falls back to an
# atomic local JSON file store (.data/sessions.json and .data/signaling.json).
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Alternatively, Vercel KV environment variables (automatically set by Vercel):
# KV_REST_API_URL=https://your-kv-url.upstash.io
# KV_REST_API_TOKEN=your_kv_token_here

# ------------------------------------------------------------------------------
# 2. WebRTC STUN / TURN Configuration
# ------------------------------------------------------------------------------
# STUN Server (default: Google Public STUN)
NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302

# TURN Server (Essential for mobile 4G/5G and symmetric NAT traversal)
# Provide your TURN URI (e.g., turn:turn.example.com:3478 or coturn / Twilio Network Traversal)
NEXT_PUBLIC_TURN_SERVER=turn:your-turn-server.com:3478
NEXT_PUBLIC_TURN_USERNAME=your_turn_username
NEXT_PUBLIC_TURN_CREDENTIAL=your_turn_password

# ------------------------------------------------------------------------------
# 3. SMS Gateway Configuration
# ------------------------------------------------------------------------------
# Supported providers: "twilio", "test"
# In development, "test" logs simulated SMS to server console without cost.
SMS_PROVIDER=twilio
SMS_API_KEY=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMS_API_SECRET=your_twilio_auth_token_here
SMS_SENDER=+12025550143

# ------------------------------------------------------------------------------
# 4. Admin Dashboard Security
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=AdminSecure2025!
ADMIN_JWT_SECRET=super-secret-jwt-key-change-this-in-production-min-32-chars
