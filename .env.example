# ==============================================================================
# SMS & WebRTC Application - Environment Configuration
# ==============================================================================

# SMS Provider Configuration
# Supported providers: "twilio", "test"
SMS_PROVIDER=twilio

# Twilio Credentials (or provider-specific API credentials)
# SMS_API_KEY: Your Twilio Account SID (e.g., ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
SMS_API_KEY=your_twilio_account_sid_here

# SMS_API_SECRET: Your Twilio Auth Token (e.g., your_auth_token)
SMS_API_SECRET=your_twilio_auth_token_here

# SMS_SENDER: Valid Twilio phone number (E.164) or approved alphanumeric Sender ID
SMS_SENDER=+12025550143

# Admin Dashboard Security
# Password used to log in at /admin
ADMIN_PASSWORD=AdminSecure2025!

# Secret key used to sign and verify Admin JWT session cookies (min 32 chars)
ADMIN_JWT_SECRET=super-secret-jwt-key-change-this-in-production-min-32-chars

# WebRTC STUN/TURN Configuration (Optional - Defaults to Google Public STUN)
# NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302
